<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:akn="http://docs.oasis-open.org/legaldocml/ns/akn/3.0"
  xmlns:ris="http://rechtsinformationen.bund.de/schema/ris/0.1"
  elementFormDefault="qualified"
  targetNamespace="http://rechtsinformationen.bund.de/schema/ris/0.1"
>
  <xs:annotation>
    <xs:documentation xml:lang="de">
      Typen, die nur im Bereich Entscheidungen der Rechtsprechung vorhanden sind.

      Diese sind nur in einer extra Datei um die Schema-Datein übersichtlicher zu haben.
    </xs:documentation>
  </xs:annotation>

  <xs:import
    namespace="http://docs.oasis-open.org/legaldocml/ns/akn/3.0"
    schemaLocation="../akn/akomantoso30.xsd"
  />

  <xs:include schemaLocation="domain-term.xsd" />

  <!-- Metadaten -->

  <xs:complexType name="datenDerMuendlichenVerhandlung">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Liste der Daten der mündlichen Verhandlung bei einem Gericht
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="datumDerMuendlichenVerhandlung"
        type="ris:datumDerMuendlichenVerhandlung"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="datumDerMuendlichenVerhandlung">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Datum einer mündlichen Verhandlung bei einem Gericht
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:date">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="abweichendeEclis">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Abweichende ECLIs

        Weitere ECLIs die für dieses Dokument verwendet werden
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="abweichenderEcli"
        type="ris:abweichenderEcli"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="abweichenderEcli">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Abweichender ECLI
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="ris:ecli">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="ecli">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        ECLI (European Case Law Identifier) zur eindeutigen Identifikation von Entscheidungen.

        https://e-justice.europa.eu/topics/legislation-and-case-law/european-case-law-identifier-ecli_de
      </xs:documentation>
      <xs:documentation xml:lang="en">
        ECLI (European Case Law Identifier) for unique identification of decisions.

        https://e-justice.europa.eu/topics/legislation-and-case-law/european-case-law-identifier-ecli_en
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern
        value="ECLI:[A-Z]{2}:[A-Za-z0-9]{1,7}:[0-9]{4}:[A-Za-z0-9.]{1,25}"
      />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="rechtskraft">
    <xs:annotation>
      <xs:documentation
        xml:lang="de"
      >Hat das Gerichtsurteil Rechtskraft erlangt?</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="ris:rechtskraftValue">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="rechtskraftValue">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Ja" />
      <xs:enumeration value="Nein" />
      <xs:enumeration value="Keine Angabe" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="tarifvertraege">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Tarifverträge
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="tarifvertrag"
        type="ris:tarifvertrag"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="tarifvertrag">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Tarifvertrag
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="quellen">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Quellen
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="quelle" type="ris:quelle" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="quelle">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Quelle
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="streitjahre">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Streitjahre
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="streitjahr"
        type="ris:streitjahr"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="streitjahr">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Streitjahr
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:gYear">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="kuendigungsgruende">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Kündigungsgründe
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="kuendigungsgrund"
        type="ris:kuendigungsgrund"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="kuendigungsgrund">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Kündigungsgrund
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="gesetzgebungsauftrag">
    <xs:annotation>
      <xs:documentation xml:lang="de">Gesetzgebungsauftrag</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <!-- ist aktuell ein freitext feld, wie sinnvoll ist das? -->
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="herkunftslaender">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Herkunftsländer
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="herkunftsland"
        type="ris:herkunftsland"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="herkunftsland">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Herkunftsland
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="vorabdokument">
    <xs:annotation>
      <xs:documentation xml:lang="de">Vorab-Dokument</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="ris:vorabdokumentValue">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="vorabdokumentValue">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Ja" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Kurztexte -->

  <xs:complexType name="entscheidungsnamen">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Namen einer Gerichtsentscheidung
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="entscheidungsname"
        type="ris:entscheidungsname"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="entscheidungsname">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Name einer Gerichtsentscheidung
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="orientierungssatz">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Orientierungssatz
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:blocksreq">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="sonstigerOrientierungssatz">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Sonstiger Orientierungssatz
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:blocksreq">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Langtexte. Die typen müssen mit xsi:type angegeben werden -->

  <xs:complexType name="tenor">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Rechtlich bindender Ausspruch des Gerichts
      </xs:documentation>
      <xs:documentation xml:lang="en">
        Legally binding ruling of the court
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="leitsatz">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Vom Spruchkörper verfasste oder mit seiner Zustimmung gebildete Leitsätze.
      </xs:documentation>
      <xs:documentation xml:lang="en">
        Headnotes authored or approved by the court panel.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent">
        <xs:attribute ref="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="gliederungRechtsprechung">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Gliederung
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent">
        <xs:attribute ref="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="tatbestand">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Teil einer Entscheidung, der die Tatsachen und Feststellungen beschreibt, von denen das Gericht ausdrücklich ausgeht. Der Tatbestand wird nur gesondert erfasst, wenn er in der Entscheidung als solcher erkennbar ist.
      </xs:documentation>
      <xs:documentation xml:lang="en">
        The section of a decision describing the facts and findings the court expressly bases its ruling on. Only recorded separately if explicitly marked as such.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent">
        <xs:attribute ref="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="gruende">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Die Gründe beinhalten sowohl die Teile, in denen die feststehenden Tatsachen und die getroffenen Feststellungen dargestellt werden, als auch die Teile, in denen die rechtliche Würdigung dieser Tatsachen und Feststellungen vorgenommen wird.
      </xs:documentation>
      <xs:documentation xml:lang="en">
        Includes both the factual findings and their legal evaluation.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent">
        <xs:attribute ref="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="entscheidungsgruende">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Teil einer Entscheidung, der sich ausschließlich mit der rechtlichen Würdigung der im Tatbestand getroffenen Feststellungen befasst.
        Die Entscheidungsgründe werden nur dann gesondert erfasst, wenn sie als solche erkennbar sind.
      </xs:documentation>
      <xs:documentation xml:lang="en">
        Section of the decision devoted solely to legal assessment of the findings established in the facts section.
        Only recorded separately if clearly identifiable.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent">
        <xs:attribute ref="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="sonstigerLangtext">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        In Sonstiger Langtext werden entsprechende Hinweise aufgenommen, wenn eine Entscheidung ohne Tatbestand und Entscheidungsgründe (nach ZPO § 313a) ergeht. In dieser Rubrik können auch (Hinweise auf) Berichtigungsbeschlüsse u. Ä. aufgenommen werden.
      </xs:documentation>
      <xs:documentation xml:lang="en">
        Contains notes on decisions without facts/reasons sections (per § 313a ZPO), and other notes such as correction orders.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent">
        <xs:attribute ref="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="abweichendeMeinung">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Als Abweichende Meinung wird der Teil einer Entscheidung erfasst, der abweichende Meinungen oder Sondervoten eines oder mehrerer an der Entscheidung mitwirkenden Richterinnen oder Richter enthält.
      </xs:documentation>
      <xs:documentation xml:lang="en">
        Contains dissenting opinions or separate votes of individual participating judges.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="akn:maincontent">
        <xs:attribute ref="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
