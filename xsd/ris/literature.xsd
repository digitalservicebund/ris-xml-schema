<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:ris="http://rechtsinformationen.bund.de/schema/ris/0.1"
  xmlns:akn="http://docs.oasis-open.org/legaldocml/ns/akn/3.0"
  elementFormDefault="qualified"
  targetNamespace="http://rechtsinformationen.bund.de/schema/ris/0.1"
>
  <xs:annotation>
    <xs:documentation xml:lang="de">
      Typen, die nur im Bereich Literatur (selbstständig und unselbstständig)
      vorhanden sind.

      Diese sind nur in einer extra Datei um die Schema-Dateien übersichtlicher zu haben.
    </xs:documentation>
  </xs:annotation>

  <xs:import
    namespace="http://docs.oasis-open.org/legaldocml/ns/akn/3.0"
    schemaLocation="../akn/akomantoso30.xsd"
  />

  <xs:complexType name="personenInstitutionen">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Liste an Personen/Institutionen. Auf diese wird z.B. aus
        ris:ueberPersonInstitution oder ris:fuerPersonInstitution verwiesen.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="personInstitution"
        type="ris:personInstitution"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="personInstitution">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Person/Institution
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="ris:personInstitutionName" />
      <xs:element
        name="zusatz"
        type="ris:personInstitutionZusatz"
        minOccurs="0"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
    <xs:attributeGroup ref="akn:showopt" />
    <xs:attributeGroup ref="akn:idreq" />
  </xs:complexType>

  <xs:complexType name="personInstitutionName">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Name einer Person/Institution
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="personInstitutionZusatz">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Zusatz zu einer Person/Institution, z.B. akademischer Titel oder Amt
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ueberPersonenInstitutionen">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Liste an Personen/Institutionen, über die dieses Dokument handelt
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="ueberPersonInstitution"
        type="ris:ueberPersonInstitution"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="ueberPersonInstitution">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Person/Institution, über die dieses Dokument handelt. Verweist über
        das refersTo-Attribut auf die näher definierte ris:personInstitution.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
        <xs:attribute name="refersTo" type="akn:conceptRef" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="fuerPersonenInstitutionen">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Liste an Personen/Institutionen, für die dieses Dokument handelt
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="fuerPersonInstitution"
        type="ris:fuerPersonInstitution"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="fuerPersonInstitution">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Person/Institution, für die dieses Dokument handelt. Verweist über
        das refersTo-Attribut auf die näher definierte ris:personInstitution.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
        <xs:attribute name="refersTo" type="akn:conceptRef" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Kongresse -->

  <xs:complexType name="kongresse">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Liste an Kongressen. Auf diese wird z.B. aus ris:kongressvermerk oder
        ris:ueberkongress verwiesen.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="kongress" type="ris:kongress" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="kongress">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Kongress, Konferenz, Tagung, Seminar oder ähnliche Veranstaltung
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="ris:stringWithDomainTerm" />
      <xs:element name="jahr" type="ris:organisationJahr" minOccurs="0" />
      <xs:element name="ort" type="ris:stringWithDomainTerm" minOccurs="0" />
      <xs:element name="land" type="ris:stringWithDomainTerm" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
    <xs:attributeGroup ref="akn:showopt" />
    <xs:attributeGroup ref="akn:idreq" />
  </xs:complexType>

  <!-- Person Role Lists -->

  <xs:complexType name="personRoleItem">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Person in einer bestimmten Rolle (z.B. Verfasser, Bearbeiter). Verweist
        über das refersTo-Attribut auf die näher definierte ris:person.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
        <xs:attribute name="refersTo" type="akn:conceptRef" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="verfasserListe">
    <xs:annotation>
      <xs:documentation xml:lang="de">Liste der Verfasser</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="verfasser"
        type="ris:personRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="mitarbeiterListe">
    <xs:annotation>
      <xs:documentation xml:lang="de">Liste der Mitarbeiter</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="mitarbeiter"
        type="ris:personRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="herausgeberPersonen">
    <xs:annotation>
      <xs:documentation xml:lang="de">Herausgebende Personen</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="herausgeberPerson"
        type="ris:personRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="begruenderListe">
    <xs:annotation>
      <xs:documentation xml:lang="de">Liste der Begründer</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="begruender"
        type="ris:personRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="bearbeiterListe">
    <xs:annotation>
      <xs:documentation xml:lang="de">Liste der Bearbeiter</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="bearbeiter"
        type="ris:personRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <!-- Institution Role Lists -->

  <xs:complexType name="organisationRoleItem">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Institution in einer bestimmten Rolle (z.B. Urheber, Verlag). Verweist
        über das refersTo-Attribut auf die näher definierte
        ris:organisation.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
        <xs:attribute name="refersTo" type="akn:conceptRef" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="kongressRoleItem">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Verweis auf einen Kongress (z.B. Kongressvermerk, Überkongress).
        Verweist über das refersTo-Attribut auf den näher definierten
        ris:kongress.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
        <xs:attribute name="refersTo" type="akn:conceptRef" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="herausgeberInstitutionen">
    <xs:annotation>
      <xs:documentation
        xml:lang="de"
      >Herausgebende Institutionen</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="herausgeberInstitution"
        type="ris:organisationRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="kongressvermerke">
    <xs:annotation>
      <xs:documentation
        xml:lang="de"
      >Liste der Kongressvermerke</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="kongressvermerk"
        type="ris:kongressRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="ueberkongresse">
    <xs:annotation>
      <xs:documentation
        xml:lang="de"
      >Liste der Über-Kongresse</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="ueberkongress"
        type="ris:kongressRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="urheberListe">
    <xs:annotation>
      <xs:documentation xml:lang="de">Liste der Urheber</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="urheber"
        type="ris:organisationRoleItem"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="veroeffentlichungsJahre">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Jahre der Veröffentlichung
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="veroeffentlichungsJahr"
        type="ris:veroeffentlichungsJahr"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="veroeffentlichungsJahr">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Jahr der Veröffentlichung
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
</xs:schema>
