fileignoreconfig:
  - filename: README.md
    allowed_patterns:
      - secrets
      - Secrets
  - filename: xsd/norm/README-de.md
    allowed_patterns:
      - 'https://gitlab\.opencode\.de/\S+'
  - filename: LICENSE
    allowed_patterns:
      - "keys"
  - filename: SECURITY.md
    allowed_patterns:
      - "public key"
  - filename: xsd/akn/akomantoso30.xsd
    allowed_patterns:
      - keyword
      - passive
  - filename: .github/workflows/pipeline.yml
    allowed_patterns:
      - "key: "
  - filename: xsd/norm/norm.sch
    checksum: a9988c413b72bb3971218747e632ac5b208f0ff6a30581dbb6e0ea3b23ea9f64
  - filename: gradlew
    checksum: df5f105ae542d08dedb564dae33c4f97a47ef1549229a69eff6de10c4de11a00
  - filename: build.gradle.kts
    allowed_patterns:
      - password
      - GITHUB_TOKEN
scopeconfig:
  - scope: node
allowed_patterns:
  - uses:\ ([A-z0-9\-]+\/)*[A-z0-9\-]+@[a-fA-F0-9]{40}
  - "secrets: inherit"
  - passiv
  - passive
  - Passivzitierung
  - secrets.REPORTS_BUCKET_ACCESS_KEY_ID
  - REPORTS_BUCKET_ACCESS_KEY_ID
  - secrets.REPORTS_BUCKET_SECRET_ACCESS_KEY
  - REPORTS_BUCKET_SECRET_ACCESS_KEY
  - BUCKET_ACCESS_KEY_ID
  - BUCKET_SECRET_ACCESS_KEY
  - a654f19fa6182ec8dabbb9bcc0d826ab07ac54f9
