<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:ris="http://rechtsinformationen.bund.de/schema/ris/0.1"
  xmlns:akn="http://docs.oasis-open.org/legaldocml/ns/akn/3.0"
  elementFormDefault="qualified"
  targetNamespace="http://rechtsinformationen.bund.de/schema/ris/0.1"
>
  <xs:annotation>
    <xs:documentation xml:lang="de">
      Typen, die nur im Bereich Verwaltungsvorschriften vorhanden sind.

      Diese sind nur in einer extra Datei um die Schema-Dateien übersichtlicher zu haben.
    </xs:documentation>
  </xs:annotation>

  <xs:import
    namespace="http://docs.oasis-open.org/legaldocml/ns/akn/3.0"
    schemaLocation="../akn/akomantoso30.xsd"
  />

  <xs:include schemaLocation="domain-term.xsd" />

  <xs:complexType name="normgeberListe">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Liste der Normgeber
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="normgeber" type="ris:normgeber" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="normgeber">
    <xs:annotation>
      <xs:documentation xml:lang="de">
      Normgeber
    </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="ris:stringWithDomainTerm" />
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="inkrafttretedatum">
    <xs:annotation>
      <xs:documentation xml:lang="de">
      Datum des Inkrafttretens
    </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:date">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ausserkraft">
    <xs:annotation>
      <xs:documentation xml:lang="de">
      Datum des Außerkrafttretens
    </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:date">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="titelAspekte">
    <xs:annotation>
      <xs:documentation xml:lang="de">
      Titelaspekte
    </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="titelAspekt"
        type="ris:titelAspekt"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="titelAspekt">
    <xs:annotation>
      <xs:documentation xml:lang="de">
      Titelaspekt
    </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="zitierdaten">
    <xs:annotation>
      <xs:documentation xml:lang="de">
      Liste von Zitierdaten
    </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="zitierdatum"
        type="ris:zitierdatum"
        maxOccurs="unbounded"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>

  <xs:complexType name="zitierdatum">
    <xs:annotation>
      <xs:documentation xml:lang="de">
      Zitierdatum
    </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:date">
        <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
        <xs:attributeGroup ref="akn:refers" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="anwendungszeitraum">
    <xs:annotation>
      <xs:documentation xml:lang="de">
        Anwendungszeitraum
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element
        name="anwendungsbeginn"
        type="ris:stringWithDomainTerm"
        minOccurs="0"
      />
      <xs:element
        name="anwendungsende"
        type="ris:stringWithDomainTerm"
        minOccurs="0"
      />
    </xs:sequence>
    <xs:attribute name="domainTerm" type="ris:domainTerm" use="required" />
  </xs:complexType>
</xs:schema>
